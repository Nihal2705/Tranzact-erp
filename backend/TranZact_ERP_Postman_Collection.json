{
  "info": {
    "_postman_id": "tranzact-erp-api-collection",
    "name": "TranZact-style ERP APIs",
    "description": "Complete collection of all 15 APIs for the TranZact-style manufacturing ERP. Owned by Person 4 and shared with Person 6.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000/api",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "POST /api/auth/login (Admin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.token) {",
                  "    pm.collectionVariables.set('token', res.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@tranzact.com\",\n  \"password\": \"admin@123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            }
          }
        },
        {
          "name": "POST /api/auth/login (Invalid Password)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@tranzact.com\",\n  \"password\": \"wrong_password\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            }
          }
        }
      ]
    },
    {
      "name": "Items",
      "item": [
        {
          "name": "GET /api/items (All items)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/items",
              "host": ["{{baseUrl}}"],
              "path": ["items"]
            }
          }
        },
        {
          "name": "GET /api/items?search=Valve",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/items?search=Valve",
              "host": ["{{baseUrl}}"],
              "path": ["items"],
              "query": [
                { "key": "search", "value": "Valve" }
              ]
            }
          }
        },
        {
          "name": "GET /api/items/low-stock",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/items/low-stock",
              "host": ["{{baseUrl}}"],
              "path": ["items", "low-stock"]
            }
          }
        },
        {
          "name": "POST /api/items (Add Item)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Gasket High-Pressure\",\n  \"item_type\": \"RAW\",\n  \"unit\": \"pcs\",\n  \"price\": 35.00,\n  \"low_stock_limit\": 40.00,\n  \"opening_qty\": 120.00\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/items",
              "host": ["{{baseUrl}}"],
              "path": ["items"]
            }
          }
        },
        {
          "name": "PUT /api/items/:id (Edit Details)",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Steel Rod (Standard Grade)\",\n  \"unit\": \"kg\",\n  \"price\": 125.00,\n  \"low_stock_limit\": 110.00\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/items/1",
              "host": ["{{baseUrl}}"],
              "path": ["items", "1"]
            }
          }
        },
        {
          "name": "PUT /api/items/:id/stock (Change Stock)",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"change_qty\": -5,\n  \"reason\": \"Damaged units discarded\",\n  \"request_id\": \"req-stock-change-001\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/items/1/stock",
              "host": ["{{baseUrl}}"],
              "path": ["items", "1", "stock"]
            }
          }
        },
        {
          "name": "GET /api/items/:id/history",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/items/1/history",
              "host": ["{{baseUrl}}"],
              "path": ["items", "1", "history"]
            }
          }
        }
      ]
    },
    {
      "name": "Orders",
      "item": [
        {
          "name": "GET /api/orders (All Orders)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/orders",
              "host": ["{{baseUrl}}"],
              "path": ["orders"]
            }
          }
        },
        {
          "name": "GET /api/orders?order_type=SALES",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/orders?order_type=SALES",
              "host": ["{{baseUrl}}"],
              "path": ["orders"],
              "query": [
                { "key": "order_type", "value": "SALES" }
              ]
            }
          }
        },
        {
          "name": "POST /api/orders (Create Order)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"order_type\": \"SALES\",\n  \"party_name\": \"Dynamic Hydraulics\",\n  \"order_date\": \"2026-11-12\",\n  \"due_date\": \"2026-11-26\",\n  \"lines\": [\n    {\n      \"item_id\": 9,\n      \"quantity\": 10,\n      \"price\": 850.00\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/orders",
              "host": ["{{baseUrl}}"],
              "path": ["orders"]
            }
          }
        },
        {
          "name": "PUT /api/orders/:id/status (Invoice & Dispatch)",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"invoice_status\": \"Created\",\n  \"dispatch\": [\n    {\n      \"order_item_id\": 1,\n      \"qty\": 5\n    }\n  ],\n  \"request_id\": \"req-dispatch-001\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/orders/2/status",
              "host": ["{{baseUrl}}"],
              "path": ["orders", "2", "status"]
            }
          }
        },
        {
          "name": "GET /api/orders/:id/timeline",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/orders/1/timeline",
              "host": ["{{baseUrl}}"],
              "path": ["orders", "1", "timeline"]
            }
          }
        }
      ]
    },
    {
      "name": "Production",
      "item": [
        {
          "name": "GET /api/production (List Production Orders)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/production",
              "host": ["{{baseUrl}}"],
              "path": ["production"]
            }
          }
        },
        {
          "name": "POST /api/production (Create Production Order)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"finished_item_id\": 9,\n  \"target_qty\": 10,\n  \"planned_date\": \"2026-11-20\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/production",
              "host": ["{{baseUrl}}"],
              "path": ["production"]
            }
          }
        },
        {
          "name": "PUT /api/production/:id/status (Progress/Complete)",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"PENDING\",\n  \"request_id\": \"prod-status-req-001\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/production/4/status",
              "host": ["{{baseUrl}}"],
              "path": ["production", "4", "status"]
            }
          }
        }
      ]
    },
    {
      "name": "Reports",
      "item": [
        {
          "name": "GET /api/reports/summary",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/reports/summary",
              "host": ["{{baseUrl}}"],
              "path": ["reports", "summary"]
            }
          }
        }
      ]
    }
  ]
}

